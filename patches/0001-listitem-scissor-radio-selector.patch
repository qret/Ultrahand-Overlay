+            // 4IFIR CHANGE -- see the modification notice at the top of this file.
+            // True when something is actually painted in the value slot on the right.
+            // Mirrors draw()'s own dispatch: the Switch2 radio mark first, otherwise
+            // ordinary value text. An empty m_value is NOT by itself proof the slot is
+            // free -- a radio selector's circle occupies it while carrying no value
+            // text at all (unselected rows have an empty m_value), which is why the
+            // focused-item scissor below must ask this instead of m_value.empty().
+            //
+            // Not virtual: ToggleListItem's slot is drawn through the same
+            // !m_value.empty() branch of draw(), so the base formula already answers
+            // correctly for it and there is nothing to override.
+            bool valueSlotOccupied() const {
+                return !m_value.empty() || (m_flags.m_radioSelector && ult::useSwitch2Style);
+            }
         private:
             void calculateWidths(gfx::Renderer* renderer) {
-                m_maxWidth = getWidth() - valueReservedWidth(renderer);
+                // 4IFIR CHANGE: clamp at zero; see the modification notice at the top.
+                //
+                // m_maxWidth is u16, the subtraction is signed. A value wide enough that
+                // valueReservedWidth() exceeds the row width made the difference negative
+                // and the store wrapped it to ~65500. Two things then went wrong at once,
+                // which is why this was so hard to recognise on the console: the label
