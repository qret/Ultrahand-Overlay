+                // tens of thousands of pixels off-screen and the value simply vanished --
+                // no ellipsis, no overlap, no clue. Clamped, an over-long value now
+                // truncates the label instead, which is visible and therefore fixable.
+                const s32 available = getWidth() - valueReservedWidth(renderer);
+                m_maxWidth = available > 0 ? static_cast<u16>(available) : 0;
             
                 const u16 width = renderer->getTextDimensions(m_text_clean, false, 23).first;
                 m_flags.m_truncated = width > m_maxWidth + 20;
