+    /*  4IFIR CHANGE 2026-09-05 -- anchor-window byte cache, scoped to one page build.
+     *
+     *  WHY. parseHexDataAtCustomOffset() caches only the anchor offset (hexSumCache);
+     *  the bytes are re-read with a fresh fopen/fseek/fread/fclose on EVERY
+     *  substitution. One summary page of a real package does 83 such opens of the same
+     *  440 KB loader.kip: 71 from {hex_file(...)} rows and 12 from
+     *  ;visibility_condition= checks that all read the very same single byte. Each open
+     *  is four IPC to fsp-srv, two of them re-walking the path through FAT.
+     *
+     *  WHY THIS IS SAFE. The scope is opened by drawCommandsMenu() and closed when it
+     *  returns; that function runs no package command, it reads files and builds list
+     *  items. Every in-place write funnels through hexEditByOffset(), which drops the
+     *  window, and the "clear hex_sum_cache" script command drops it too. The scope
+     *  depth is thread_local, so the interpreter thread -- the one that actually writes
+     *  -- never has a scope open and always reads from disk. With no scope open the
+     *  behaviour is byte for byte the old one.
+     *
+     *  A WINDOW, NOT THE FILE. 16 KB from the anchor covers every offset a package is
+     *  known to use (the largest ours touches is 12529). Anything outside falls through
+     *  to the plain read, unchanged.
+     */
+    inline constexpr size_t HEX_SCOPE_WINDOW = 16384;
+
+    void beginHexReadScope();
+    void endHexReadScope();
+    void clearHexReadScope();
+
+    struct HexReadScopeGuard {
+        HexReadScopeGuard()  { beginHexReadScope(); }
+        ~HexReadScopeGuard() { endHexReadScope(); }
+        HexReadScopeGuard(const HexReadScopeGuard&) = delete;
+        HexReadScopeGuard& operator=(const HexReadScopeGuard&) = delete;
+    };
